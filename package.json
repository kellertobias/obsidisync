{
  "name": "obsidian-ios-git-sync",
  "version": "0.7.1",
  "description": "Obsidian sync plugin for iOS, iPadOS, and macOS plus a low-footprint server-side Git worker.",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kellertobias/obsidisync.git"
  },
  "bugs": {
    "url": "https://github.com/kellertobias/obsidisync/issues"
  },
  "homepage": "https://github.com/kellertobias/obsidisync#readme",
  "scripts": {
    "build": "npm run build:plugin && npm run build:server",
    "build:plugin": "tsc -p tsconfig.json --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "build:server": "cargo build --manifest-path rust-server/Cargo.toml --release",
    "dev": "node esbuild.config.mjs",
    "release": "semantic-release",
    "start:server": "cargo run --manifest-path rust-server/Cargo.toml",
    "test": "npm run test:plugin && npm run build:plugin && npm run test:server",
    "test:plugin": "node -e \"require('fs').rmSync('.tmp-tests',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test .tmp-tests/tests/*.test.js",
    "test:server": "cargo test --manifest-path rust-server/Cargo.toml",
    "test:e2e": "cargo build --manifest-path rust-server/Cargo.toml && node -e \"require('fs').rmSync('.tmp-tests',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node tests/e2e/harness.js"
  },
  "keywords": [
    "obsidian",
    "git",
    "ios",
    "ipad"
  ],
  "author": "Tobias S. Keller",
  "license": "MIT",
  "devDependencies": {
    "@saithodev/semantic-release-gitea": "^2.1.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^20.11.30",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "semantic-release": "^25.0.5",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "handlebars": "^4.7.10",
    "tar": "^7.5.21",
    "undici@^7.0.0": "^7.29.1",
    "js-yaml@^4.0.0": "^4.3.2",
    "source-map-js": "^1.2.2",
    "brace-expansion@^1.0.0": "^1.1.21",
    "brace-expansion@^2.0.0": "^2.1.7",
    "brace-expansion@^3.0.0": "^3.0.8",
    "brace-expansion@^5.0.0": "^5.0.12",
    "ip-address": "^10.5.1",
    "picomatch@^4.0.0": "^4.0.4",
    "postcss-selector-parser": "^7.1.6",
    "undici@^6.0.0": "^6.29.0",
    "got@^10.0.0": "^11.8.6"
  }
}
